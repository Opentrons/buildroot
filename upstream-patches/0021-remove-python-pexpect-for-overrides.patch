 delete mode 100644 package/python-pexpect/python-pexpect.mk

diff --git a/package/Config.in b/package/Config.in
index 2b4b6940..a4abdbf8 100644
--- a/package/Config.in
+++ b/package/Config.in
@@ -1164,7 +1164,6 @@ menu "External python modules"
