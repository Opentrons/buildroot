 .../python-setuptools/python-setuptools.mk    | 17 -----
 5 files changed, 103 deletions(-)
 delete mode 100644 package/python-setuptools/0001-add-executable.patch
 delete mode 100644 package/python-setuptools/Config.in
 delete mode 100644 package/python-setuptools/python-setuptools.hash
 delete mode 100644 package/python-setuptools/python-setuptools.mk

diff --git a/package/Config.in b/package/Config.in
index d3c38845..08c18a75 100644
--- a/package/Config.in
+++ b/package/Config.in
@@ -1265,7 +1265,6 @@ menu "External python modules"
 	source "package/python-serial-asyncio/Config.in"
 	source "package/python-service-identity/Config.in"
 	source "package/python-setproctitle/Config.in"
